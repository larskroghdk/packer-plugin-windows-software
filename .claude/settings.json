{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go mod tidy -diff)",
      "Bash(gofmt -l:*)",
      "Bash(staticcheck:*)",
      "Bash(actionlint:*)",
      "Bash(packer fmt -check:*)",
      "Bash(pwsh -NoProfile -File scripts/check.ps1)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh api --method PUT:*)",
      "Bash(packer build:*)",
      "Bash(pwsh -NoProfile -File scripts/publish-artifacts.ps1:*)"
    ]
  }
}
